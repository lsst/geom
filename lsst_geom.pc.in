prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib
doxygen_tag=${prefix}/doc/geom.tag
lsst_build_requires=boost_test pybind11 python3

Name: lsst_geom
Description: LSST Science Pipelines geometry primitives
Version: @VERSION@
Requires: boost_math eigen3 ndarray lsst_pex_exceptions lsst_sphgeom lsst_cpputils
Cflags: -I${includedir}
Libs: -L${libdir} -lgeom
